{
    "name": "mulertech/blog-bundle",
    "description": "Symfony bundle for a Markdown blog: shared article model, admin, public pages, full-text search, social sharing and SEO, with one article per language",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": [
        "php",
        "symfony",
        "blog",
        "markdown",
        "doctrine",
        "postgresql",
        "full-text-search",
        "seo",
        "multilingual"
    ],
    "authors": [
        {
            "name": "Sébastien Muler",
            "email": "sebastien.muler@mulertech.net"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-exif": "*",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "doctrine/dbal": "^4.0",
        "doctrine/orm": "^3.0",
        "league/commonmark": "^2.0",
        "mulertech/file-bundle": "^1.1",
        "mulertech/seo-bundle": "^1.7",
        "symfony/asset": "^8.0",
        "symfony/asset-mapper": "^8.0",
        "symfony/clock": "^8.0",
        "symfony/config": "^8.0",
        "symfony/dependency-injection": "^8.0",
        "symfony/form": "^8.0",
        "symfony/http-foundation": "^8.0",
        "symfony/http-kernel": "^8.0",
        "symfony/mime": "^8.0",
        "symfony/routing": "^8.0",
        "symfony/security-core": "^8.0",
        "symfony/security-csrf": "^8.0",
        "symfony/string": "^8.0",
        "symfony/translation": "^8.0",
        "symfony/translation-contracts": "^3.0",
        "symfony/twig-bundle": "^8.0",
        "symfony/uid": "^8.0",
        "symfony/validator": "^8.0",
        "twig/extra-bundle": "^3.0",
        "twig/markdown-extra": "^3.0",
        "twig/twig": "^3.0"
    },
    "require-dev": {
        "ext-pdo_sqlite": "*",
        "doctrine/doctrine-bundle": "^3.3",
        "friendsofphp/php-cs-fixer": "^3.0",
        "mulertech/csp-bundle": "^3.2",
        "mulertech/docker-dev": "^3.2",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^12.0",
        "roave/security-advisories": "dev-latest",
        "symfony/browser-kit": "^8.0",
        "symfony/css-selector": "^8.0",
        "symfony/dom-crawler": "^8.0",
        "symfony/framework-bundle": "^8.0",
        "symfony/security-bundle": "^8.0",
        "symfony/yaml": "^8.0"
    },
    "suggest": {
        "mulertech/csp-bundle": "Adds its CSP nonce to the structured data script of the article page"
    },
    "autoload": {
        "psr-4": {
            "MulerTech\\BlogBundle\\": "./src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MulerTech\\BlogBundle\\Tests\\": "./tests"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
