<div class="mb-6 flex flex-wrap items-center gap-3 rounded-xl bg-white p-4 shadow">
    <span class="mr-auto text-gray-700">
        {% if post.published %}
            {{ 'admin.published_on'|trans({'%date%': post.publishedAt|date('blog.date_format'|trans({}, 'MulerTechBlogBundle'))}, 'MulerTechBlogBundle') }}
        {% else %}
            {{ 'admin.draft'|trans({}, 'MulerTechBlogBundle') }}
        {% endif %}
    </span>
    {% if post.published %}
        <a href="{{ path('mulertech_blog_show', {slug: post.slug, _locale: post.locale}) }}" target="_blank" class="text-gray-900 underline">{{ 'admin.view'|trans({}, 'MulerTechBlogBundle') }}</a>
        <form method="post" action="{{ path('mulertech_blog_admin_unpublish', {id: post.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('mulertech_blog_publish_' ~ post.id) }}">
            <button type="submit" class="rounded-lg bg-gray-100 px-4 py-2 font-semibold text-gray-900 hover:bg-gray-200">{{ 'admin.unpublish'|trans({}, 'MulerTechBlogBundle') }}</button>
        </form>
    {% else %}
        <form method="post" action="{{ path('mulertech_blog_admin_publish', {id: post.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('mulertech_blog_publish_' ~ post.id) }}">
            <button type="submit" class="rounded-lg bg-gray-900 px-4 py-2 font-semibold text-white hover:bg-gray-700">{{ 'admin.publish'|trans({}, 'MulerTechBlogBundle') }}</button>
        </form>
    {% endif %}
    <form method="post" action="{{ path('mulertech_blog_admin_delete', {id: post.id}) }}" data-mulertech-blog-confirm="{{ 'admin.delete_confirm'|trans({'%title%': post.title}, 'MulerTechBlogBundle') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('mulertech_blog_delete_' ~ post.id) }}">
        <button type="submit" class="rounded-lg bg-red-600 px-4 py-2 font-semibold text-white hover:bg-red-500">{{ 'admin.delete'|trans({}, 'MulerTechBlogBundle') }}</button>
    </form>
</div>
