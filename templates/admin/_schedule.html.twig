{#
    The publication date, on a line of its own below the publication buttons: the label, the
    date and the button read as one setting. Shown only while the article can be scheduled:
    one published before keeps its date, so only a draft never shown, or one still waiting
    for its date, can be.
#}
{% if post.publishedAt is null or post is mulertech_blog_scheduled %}
    <form method="post" action="{{ path('mulertech_blog_admin_schedule', {id: post.id}) }}" class="flex flex-wrap items-center gap-3 border-t border-gray-200 pt-4">
        <input type="hidden" name="_token" value="{{ csrf_token('mulertech_blog_publish_' ~ post.id) }}">
        <label for="mulertech-blog-schedule" class="text-sm font-medium text-gray-700">{{ 'admin.schedule_label'|trans({}, 'MulerTechBlogBundle') }}</label>
        <input type="datetime-local" id="mulertech-blog-schedule" name="published_at" required
               value="{{ post is mulertech_blog_scheduled ? post.publishedAt|date('Y-m-d\\TH:i') : '' }}"
               class="rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-gray-900 focus:outline-none focus:ring-2 focus:ring-gray-900/20">
        <button type="submit" class="rounded-lg bg-gray-100 px-4 py-2 font-semibold text-gray-900 hover:bg-gray-200">{{ 'admin.schedule'|trans({}, 'MulerTechBlogBundle') }}</button>
    </form>
{% endif %}
