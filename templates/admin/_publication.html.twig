{#
    The buttons that change when readers see an article, shown above the edit form and at
    the end of the preview, where the review ends. Each one is a flex item: the page including
    them lays them out. A site adds its own around the publish button by overriding the
    `publish` block.
#}
{% if post.published %}
    <form method="post" action="{{ path('mulertech_blog_admin_unpublish', {id: post.id}) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('mulertech_blog_publish_' ~ post.id) }}">
        <button type="submit" class="rounded-lg bg-gray-100 px-4 py-2 font-semibold text-gray-900 hover:bg-gray-200">{{ 'admin.unpublish'|trans({}, 'MulerTechBlogBundle') }}</button>
    </form>
{% endif %}
{% if not post.published or post is mulertech_blog_scheduled %}
    {% block publish %}
        <form method="post" action="{{ path('mulertech_blog_admin_publish', {id: post.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('mulertech_blog_publish_' ~ post.id) }}">
            <button type="submit" class="rounded-lg bg-gray-900 px-4 py-2 font-semibold text-white hover:bg-gray-700">{{ (post.published ? 'admin.publish_now' : 'admin.publish')|trans({}, 'MulerTechBlogBundle') }}</button>
        </form>
    {% endblock %}
{% endif %}
