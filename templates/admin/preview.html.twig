{#
    The article in the site's public template, with a banner saying it is a preview: the
    template is the one the site may have replaced, so the preview shows what readers will.
    The publication panel takes the place of what the site shows after the article, where
    the review ends: what is meant for readers has no use to the one reviewing.
#}
{% extends '@MulerTechBlog/blog/show.html.twig' %}

{% block body %}
    <div class="bg-gray-900 px-4 py-3 text-center text-sm text-white" role="status">
        {{ (post.published ? 'admin.preview.banner_published' : 'admin.preview.banner_draft')|trans({}, 'MulerTechBlogBundle') }}
        <a href="{{ path('mulertech_blog_admin_edit', {id: post.id}) }}" class="ml-2 font-semibold text-white underline">{{ 'admin.preview.back'|trans({}, 'MulerTechBlogBundle') }}</a>
    </div>
    {{ parent() }}
{% endblock %}

{% block after_article %}
    <section class="my-8 space-y-4 rounded-xl bg-white p-6 shadow-lg ring-1 ring-gray-200" aria-labelledby="mulertech-blog-publication">
        <div class="flex flex-wrap items-center gap-3">
            <h2 id="mulertech-blog-publication" class="mr-auto text-lg font-semibold text-gray-900">{{ 'admin.preview.publication'|trans({}, 'MulerTechBlogBundle') }}</h2>
            {% include '@MulerTechBlog/admin/_publication.html.twig' %}
        </div>
        {% include '@MulerTechBlog/admin/_schedule.html.twig' %}
    </section>
{% endblock %}
