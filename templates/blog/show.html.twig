{% extends layout %}
{% import '@MulerTechBlog/blog/_icons.html.twig' as icons %}

{% block title %}{{ post.title }}{% endblock %}

{# Replaces the layout's own block: whether a layout leaves it empty or includes the
   seo-bundle template there, the page then carries its meta tags exactly once. #}
{% block seo_meta %}
    {% include '@MulerTechSeo/seo_meta.html.twig' with {seo: seo} only %}
    <link rel="alternate" type="application/atom+xml" title="{{ 'blog.title'|trans({}, 'MulerTechBlogBundle') }}" href="{{ mulertech_blog_feed_url(post.locale, true) }}">
    {% if translations is not empty %}
        {% for version in [post]|merge(translations) %}
            <link rel="alternate" hreflang="{{ version.locale }}" href="{{ mulertech_blog_post_url(version, true) }}">
        {% endfor %}
    {% endif %}
    {{ schema_org_json_ld('blogPosting', post, nonce=mulertech_blog_csp_nonce()) }}
{% endblock %}

{% block body %}
    <article class="bg-white">
        {% if post.featuredImage %}
            <div class="bg-gray-900">
                <img src="{{ mulertech_blog_file_url(post, post.featuredImage) }}"
                     alt="{{ 'blog.post.cover_alt'|trans({'%title%': post.title}, 'MulerTechBlogBundle') }}"
                     class="mx-auto h-auto max-h-[36rem] w-full object-contain" fetchpriority="high" decoding="async">
            </div>
        {% endif %}

        <div class="container mx-auto max-w-4xl px-4 py-12">
            <header class="mb-8">
                {% if post.category %}
                    <a href="{{ path('mulertech_blog_index', {category: post.category.slug}) }}" class="mb-4 inline-block rounded-full bg-gray-100 px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-200">{{ post.category.name }}</a>
                {% endif %}
                <h1 class="mb-6 text-3xl font-bold text-gray-900 md:text-5xl">{{ post.title }}</h1>
                <div class="flex flex-wrap items-center gap-6 text-gray-600">
                    {% if post.publishedAt %}
                        <span class="inline-flex items-center gap-2">{{ icons.icon('calendar', 'h-5 w-5') }}<time datetime="{{ post.publishedAt|date('Y-m-d') }}">{{ 'blog.post.published_on'|trans({'%date%': post.publishedAt|date('blog.date_format'|trans({}, 'MulerTechBlogBundle'))}, 'MulerTechBlogBundle') }}</time></span>
                    {% endif %}
                    <span class="inline-flex items-center gap-2">{{ icons.icon('clock', 'h-5 w-5') }}{{ 'blog.post.reading_time'|trans({'%minutes%': post.readingTime}, 'MulerTechBlogBundle') }}</span>
                    <span class="inline-flex items-center gap-2">{{ icons.icon('eye', 'h-5 w-5') }}{{ 'blog.card.views'|trans({'%count%': post.viewCount}, 'MulerTechBlogBundle') }}</span>
                </div>
                {% if post.aiGenerated %}
                    {# An <img> rather than inline: the official SVG declares generic classes,
                       .cls-1 and .cls-2, which would collide with the site's stylesheet. #}
                    <p class="mt-6 flex items-center gap-3 text-sm text-gray-700">
                        <img src="{{ asset('@mulertech/blog-bundle/images/eu-ai-label-ai-generated.svg') }}"
                             alt="{{ 'blog.post.ai_label_alt'|trans({}, 'MulerTechBlogBundle') }}"
                             width="88" height="28" class="h-7 w-auto" decoding="async">
                        {{ 'blog.post.ai_generated'|trans({}, 'MulerTechBlogBundle') }}
                    </p>
                {% endif %}
                {% if post.tags is not empty %}
                    <ul class="mt-6 flex flex-wrap gap-2" aria-label="{{ 'blog.post.tags'|trans({}, 'MulerTechBlogBundle') }}">
                        {% for tag in post.tags %}
                            <li><a href="{{ path('mulertech_blog_index', {tag: tag.slug}) }}" class="rounded-full bg-gray-100 px-3 py-1 text-sm text-gray-700 hover:bg-gray-200">#{{ tag.name }}</a></li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </header>

            <div class="prose prose-lg max-w-none [&_table]:block [&_table]:overflow-x-auto">
                {{ post|mulertech_blog_content|markdown_to_html }}
            </div>

            {% include '@MulerTechBlog/blog/_share.html.twig' %}
            {% include '@MulerTechBlog/blog/_navigation.html.twig' %}
        </div>
    </article>
{% endblock %}
