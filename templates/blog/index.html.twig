{% extends layout %}

{% block title %}{{ 'blog.title'|trans({}, 'MulerTechBlogBundle') }}{% endblock %}

{% block seo_meta %}
    {% include '@MulerTechSeo/seo_meta.html.twig' with {seo: seo} only %}
{% endblock %}

{% block body %}
    {% block mulertech_blog_header %}
        <section class="bg-gray-900 py-16 text-white">
            <div class="container mx-auto px-4 text-center">
                <h1 class="text-4xl font-bold md:text-5xl">{{ 'blog.title'|trans({}, 'MulerTechBlogBundle') }}</h1>
            </div>
        </section>
    {% endblock %}

    <section class="border-b bg-white py-8">
        <div class="container mx-auto max-w-6xl px-4">
            {% include '@MulerTechBlog/blog/_search.html.twig' %}
        </div>
    </section>

    <section class="bg-gray-50 py-12">
        <div class="container mx-auto grid max-w-7xl grid-cols-1 gap-8 px-4 lg:grid-cols-3">
            <div class="lg:col-span-2">
                {% if page.items is not empty %}
                    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
                        {% for post in page.items %}
                            {% include '@MulerTechBlog/blog/_card.html.twig' with {post: post, eager: loop.first} only %}
                        {% endfor %}
                    </div>
                    {% include '@MulerTechBlog/blog/_pagination.html.twig' %}
                {% else %}
                    <div class="py-12 text-center">
                        <p class="text-xl text-gray-700">{{ 'blog.empty'|trans({}, 'MulerTechBlogBundle') }}</p>
                        {% if search %}
                            <a href="{{ path('mulertech_blog_index') }}" class="mt-4 inline-block text-gray-900 underline">{{ 'blog.show_all'|trans({}, 'MulerTechBlogBundle') }}</a>
                        {% endif %}
                    </div>
                {% endif %}
            </div>
            <aside class="space-y-8">
                {% include '@MulerTechBlog/blog/_sidebar.html.twig' %}
            </aside>
        </div>
    </section>
{% endblock %}
