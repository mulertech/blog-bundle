{# The category or the tag the list is filtered by, with the way back to the whole list. #}
{% if category or tag %}
    <div class="mt-4 flex items-center justify-between gap-4">
        <div>
            <h2 class="text-2xl font-bold text-gray-900">
                {% if category %}
                    {{ 'blog.filter.category'|trans({'%name%': category.name}, 'MulerTechBlogBundle') }}
                {% else %}
                    {{ 'blog.filter.tag'|trans({'%name%': tag.name}, 'MulerTechBlogBundle') }}
                {% endif %}
            </h2>
            {% if category and category.description %}
                <p class="mt-2 text-gray-700">{{ category.description }}</p>
            {% endif %}
        </div>
        <a href="{{ path('mulertech_blog_index') }}" class="shrink-0 text-gray-900 underline hover:text-gray-600">{{ 'blog.show_all'|trans({}, 'MulerTechBlogBundle') }}</a>
    </div>
{% endif %}
